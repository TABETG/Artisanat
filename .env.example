# Copier ce fichier en .env (local) — et mettre les mêmes valeurs dans Netlify
# ATTENTION : seules les deux variables VITE_ ci-dessous sont visibles par les visiteurs.
# Ne mettez JAMAIS une clé secrète dans une variable qui commence par VITE_ (la construction est bloquée si c'est le cas).
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Uniquement côté serveur (Netlify → Site configuration → Environment variables)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Facultatif — emails automatiques (compte gratuit sur resend.com, domaine vérifié)
RESEND_API_KEY=re_...
EMAIL_FROM=Artisanat <boutique@votre-domaine.fr>
OWNER_EMAIL=proprietaire@exemple.fr

# Facultatif — clé servant à fabriquer les codes de cartes cadeaux (sinon dérivée de STRIPE_WEBHOOK_SECRET)
GIFT_CARD_SECRET=une-autre-longue-phrase-secrete

# Facultatif — clé des liens de désinscription (sinon dérivée de la clé serveur Supabase)
NEWSLETTER_SECRET=une-longue-phrase-secrete

