# Copier ce fichier en .env (local) — et mettre les mêmes valeurs dans Netlify
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Uniquement côté serveur (Netlify → Site configuration → Environment variables)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Facultatif — email au propriétaire quand un produit passe en rupture (compte gratuit sur resend.com)
RESEND_API_KEY=re_...
OWNER_EMAIL=proprietaire@exemple.fr
